# ┌──────────────────────────────────────────────────────────────────────┐
# │  Clutch — docker-compose configuration                              │
# │                                                                     │
# │  Copy this file to `.env` (next to docker-compose.yml) and edit     │
# │  what you need:                                                     │
# │                                                                     │
# │      cp docker-compose.env.example .env                             │
# │      docker compose pull && docker compose up -d                    │
# │                                                                     │
# │  `docker compose` reads `.env` automatically, so you never have to  │
# │  edit docker-compose.yml. Every entry is OPTIONAL — remove it (or   │
# │  leave it commented) to keep the built-in default.                  │
# └──────────────────────────────────────────────────────────────────────┘

# ══════════════════════════════════════════════════════════════════════
#  IMAGE SELECTION
#  Read by docker compose itself, not by the container.
# ══════════════════════════════════════════════════════════════════════

# Image tag to pull:
#   latest  — latest stable release (default)
#   dev     — latest development build (published as a GitHub prerelease)
#   2.7.0   — a specific version
CLUTCH_IMAGE_TAG=latest

# Image variant:
#   clutch          — full Arch image (~1.5 GB): shell, package manager and
#                     in-place upgrades via `clutch --upgrade` (default)
#   clutch-minimal  — Scratch-based (~280 MB): no shell, you must pull to upgrade
CLUTCH_IMAGE_VARIANT=clutch

# ══════════════════════════════════════════════════════════════════════
#  RELEASE CHANNEL FOR THE IN-DASHBOARD UPDATER
#  Keep it aligned with CLUTCH_IMAGE_TAG: `dev` image -> `dev` channel.
#  Without this the dashboard keeps offering you the newest *stable*
#  release on top of your development build. Leave it empty to let the
#  app decide.
# ══════════════════════════════════════════════════════════════════════
#CLUTCH_UPDATE_CHANNEL=dev

# ══════════════════════════════════════════════════════════════════════
#  PATHS AND PORT
# ══════════════════════════════════════════════════════════════════════

# Host port for the web dashboard. The container always listens on 8765.
#CLUTCH_PORT=8765

# Host directory mounted as your media root.
#CLUTCH_MEDIA_DIR=/path/to/media

# Path that CLUTCH_MEDIA_DIR is mounted on *inside* the container. Change it
# only if your presets reference absolute paths, e.g. /NAS02.
#CLUTCH_MEDIA_MOUNT=/media

# Host directory for the configuration (presets, watchers, queue database).
# If unset, a named `clutch-config` volume is used instead.
#CLUTCH_CONFIG_DIR=/path/to/config

# Where the SQLite queue database lives inside the container.
# Default: /config/service.db
#CLUTCH_SERVICE_DB=/config/service.db

# Comma-separated directories the service may read and write (paths *inside*
# the container). Default: /media
#CLUTCH_ALLOW_ROOTS=/media,/NAS02

# ══════════════════════════════════════════════════════════════════════
#  USER AND TIMEZONE
# ══════════════════════════════════════════════════════════════════════

# Run as this user/group so output files are not owned by root.
#CLUTCH_UID=1000
#CLUTCH_GID=1000

# Timezone, used for log timestamps.
TZ=Europe/Madrid

# ══════════════════════════════════════════════════════════════════════
#  CONVERSION
# ══════════════════════════════════════════════════════════════════════

# Number of conversions to run in parallel. Default: 1
#CLUTCH_WORKERS=1

# Comma-separated GPU indices used for NVENC; jobs rotate across them.
# Only useful when the NVIDIA device reservation is enabled in
# docker-compose.yml.
#CLUTCH_GPUS=0

# Print extra HandBrake diagnostics in the container log. Useful when a
# conversion fails and you need to see the exact HandBrakeCLI command.
#CLUTCH_DEBUG=true

# ══════════════════════════════════════════════════════════════════════
#  WATCH DIRECTORIES
#  Folders scanned automatically while the service runs. You can configure
#  watchers from the dashboard instead; these are the startup defaults.
# ══════════════════════════════════════════════════════════════════════

# Comma-separated list of container paths to watch.
#CLUTCH_WATCH_DIRS=/media/downloads

# Descend into subdirectories of every watched directory. Default: false
#CLUTCH_WATCH_RECURSIVE=true

# ══════════════════════════════════════════════════════════════════════
#  SCHEDULE / ELECTRICITY PRICE
#  Not configured here. Time windows and price rules are managed from the
#  dashboard (Schedule page) and stored in the service database, which
#  always takes priority over any environment variable.
# ══════════════════════════════════════════════════════════════════════
